# docker compose가 자동으로 읽는 환경변수 파일
# 사용법: cp .env.example .env 후 키 입력

# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=

# 필요 시 모델 변경 (기본: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# 다른 프로젝트와 포트가 겹칠 때 변경 (기본: web=3000, api=8000, db=5432)
# WEB_PORT=3001
# API_PORT=8001
# DB_PORT=5433
